# ===== DeepSeek 大模型配置（必填）=====
# 在 https://platform.deepseek.com 申请 API Key 后填入
DEEPSEEK_API_KEY=
# 官方模型名可能变更：若调用报"模型不存在"，请改为官方文档当前模型名
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEMPERATURE=0.7

# ===== Embedding 配置 =====
# 首次运行会自动下载模型（约100MB）；国内网络慢可设 HF_ENDPOINT=https://hf-mirror.com
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# HF_ENDPOINT=https://hf-mirror.com

# ===== 存储路径 =====
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_PATH=./data/ican.db
UPLOAD_DIR=./data/uploads

# ===== 上传限制 =====
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=300

# ===== 前端地址（CORS）=====
CORS_ORIGINS=http://localhost:5173
